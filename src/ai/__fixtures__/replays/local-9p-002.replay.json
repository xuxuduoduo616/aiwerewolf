  "wolfChat": [
    {
      "round": 1,
      "speakerId": 3,
      "message": "リサさん、ダンの発言が不自然に感じます。彼は本物の占い師とは考えにくいです。"
    },
    {
      "round": 1,
      "speakerId": 4,
      "message": "あの人の急ぎ理由だけだと弱いよ！もう一人吊ろうだよ！"
    },
    {
      "round": 1,
      "speakerId": 9,
      "message": "承知ですわ。CO状況を見て、私は控えめに整合を取りますの。"
    },
    {
      "round": 2,
      "speakerId": 3,
      "message": "了解。明日は「白先噛み=真要素では？」で揺さぶるね、ふふ"
    },
    {
      "round": 2,
      "speakerId": 4,
      "message": "@あの人  占い先、寡黙どころが無難かねぇ"
    },
    {
      "round": 2,
      "speakerId": 9,
      "message": "占い師が2人現れた。これは一方が真の占い師で、もう一方が狂人であることを意味する。"
    }
