  "wolfChat": [
    {
      "round": 1,
      "speakerId": 7,
      "message": "私が前衛であの人へ詰める。もう一人は後衛で票だけ合わせて。"
    },
    {
      "round": 1,
      "speakerId": 8,
      "message": "@あの人  私はもう占い師として出ているから、君はそのまま潜伏でお願い。占い先は私が適宜決めるわ。"
    },
    {
      "round": 1,
      "speakerId": 10,
      "message": "あの人噛みは騎士のリスクが高い。今は潜伏を優先して。もう一人への攻撃も逆効果。Over"
    },
    {
      "round": 2,
      "speakerId": 7,
      "message": "今夜あの人氏は重要な標的になるかもしれない。もしそれで大丈夫なら、おそらくもう一人は彼を守らないだろう。計算された一手だと思う。"
    },
    {
      "round": 2,
      "speakerId": 8,
      "message": "エミルを襲撃するのは賛成よ。彼は目立ってないし、混乱を誘えるわね。"
    },
    {
      "round": 2,
      "speakerId": 10,
      "message": "今回の噛みはあの人が良さそう。目立たず票は散らす方向でいくね。占い騙りどうする？"
    },
    {
      "round": 3,
      "speakerId": 7,
      "message": "あの人の結果は信頼できるけど、次の占い先は慎重に決めたいね。"
    },
    {
      "round": 3,
      "speakerId": 8,
      "message": "あの人、お見事。Day1も潜伏継続で。狂人の出方を待ちつつ精査を進めよう。Over"
    },
    {
      "round": 3,
      "speakerId": 10,
      "message": "あの人もユキも判定理由が薄いわね。本当に信用できるかしら"
    },
    {
      "round": 4,
      "speakerId": 7,
      "message": "我建议刀3号。"
    },
    {
      "round": 4,
      "speakerId": 8,
      "message": "今日も元気ですね！皆さんの様子はどうですか？"
    },
    {
      "round": 4,
      "speakerId": 10,
      "message": "今日のフォーカスはユリかな、彼女は発言が控えめで目立たない印象だよ。"
    },
    {
      "round": 5,
      "speakerId": 7,
      "message": "信じるかは個人の自由だけど、占い師を信じるのは合理的だねですよぅ！"
    },
    {
      "round": 5,
      "speakerId": 8,
      "message": "昨夜 @あの人 を占い、白でした。@もう一人のCOは偽物です。私は本物の占い師です。"
    },
    {
      "round": 5,
      "speakerId": 10,
      "message": "承知。昼は目立ちすぎず、かつ寡黙で怪しまれない程度に村人として振る舞いましょう。Over"
    }
  ],
