  "wolfChat": [
    {
      "round": 1,
      "speakerId": 3,
      "message": "他に何か共有しておくべき懸念事項や、作戦の詳細はありますでしょうか。"
    },
    {
      "round": 1,
      "speakerId": 4,
      "message": "正直まだ決め手ないですが、今日はミユさんに投票します"
    },
    {
      "round": 1,
      "speakerId": 7,
      "message": "占い師が3人も現れるとは、実に興味深い展開になってきましたね。"
    },
    {
      "round": 2,
      "speakerId": 3,
      "message": "私前衛。あの人吊り軸。狂人不在なら私が占いに出る。"
    },
    {
      "round": 2,
      "speakerId": 4,
      "message": "あの人は撤回で信用が落ちたし、黒先のもう一人より今日はそこ吊りが筋だと思う！"
    },
    {
      "round": 2,
      "speakerId": 7,
      "message": "@あの人  報告ありがとうございます。それが私たちの唯一の証拠です。したがって、印象に基づくもう一人への投票は非論理的です。"
    },
    {
      "round": 3,
      "speakerId": 3,
      "message": ">>あの人 それは急な断言だね。具体的な根拠を聞きたいな。"
    },
    {
      "round": 3,
      "speakerId": 4,
      "message": "あの人吊りで確定。夜は予定通り霊媒のもう一人を噛む。余計なことは言わずあの人に票を固めて。Over"
    },
    {
      "round": 3,
      "speakerId": 7,
      "message": "@あの人  もう一人占い結果がまだ。占ってから判断しない?判断材料はもう少し集めたい。矛盾点を洗い出したい。根"
    },
    {
      "round": 4,
      "speakerId": 3,
      "message": "あの人、占い先の理由ひとつ具体で言ってだよ！"
    },
    {
      "round": 4,
      "speakerId": 4,
      "message": "あの人噛み進行で異論なければ押します。明日はユキ吊り推し。護衛は霊媒師濃厚、ルカ噛みは一日様子見で。"
    },
    {
      "round": 4,
      "speakerId": 7,
      "message": "占い真贋はまだ早いかな。  @あの人   もう一人占い理由、具体的に教えてほしいな"
    },
    {
      "round": 5,
      "speakerId": 3,
      "message": "今日も元気ですね！皆さんの様子はどうですか？"
    },
    {
      "round": 5,
      "speakerId": 4,
      "message": "今日はあの人が占い師のようだね！もう一人を占うのがいいと思うよ。彼女の発言が疑わしいから、結果が@リョウリョウさん、占い先はもう一人でどうかな？疑問点を解決したいよ！"
    },
    {
      "round": 5,
      "speakerId": 7,
      "message": "あの人は黒出しだけで根拠薄いだよ。次は吊りでいいだな"
    }
  ],
