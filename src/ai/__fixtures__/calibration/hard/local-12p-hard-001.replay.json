  "speeches": [
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 1,
      "text": "[human speech omitted]"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 2,
      "text": "我的理由可以说清楚。我就追问一个点。夜占いであの人は人間判定です。俺が本物占い師につきもう一人は偽物です。  @あの人 、俺としては誤解かと存じます。結果保持は確証収集優先の村利益重視です。確実な狼候補へ議論を。（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 3,
      "text": "我的理由可以说清楚。大家先把注意力放到这一点上。みんな、初日は緊張するね。情報共有大事だよ！（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 4,
      "text": "我的理由可以说清楚。我就追问一个点。あの人の追及は精査に集中していたと言えば流せます。夜は予定通りもう一人を噛みましょう。あの人が真に見えます（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 5,
      "text": "我的理由可以说清楚。大家先把注意力放到这一点上。違う、あの人の占い結果は間違ってるですよぅ！（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 6,
      "text": "我的理由可以说清楚。大家先把注意力放到这一点上。あの人の主張には根拠がなく、今日はあの人を追放するのが妥当です。（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 7,
      "text": "我还在琢磨。我就追问一个点。あの人の死は気がかりだ—手短な一行の考察と、役職COがあれば申告を。  @もう一人  昨日はやけに落ち着いていた—誰を疑ってる？ 具体的な証拠が出るまでは大人しくしてる。 Over（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 8,
      "text": "我还在琢磨。我就说一句。あの人白なら僕の押しは状況ミス！今日は黒先の反応を見る！（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 9,
      "text": "我的理由可以说清楚。我先把自己的思路说清楚。@あの人  「calm」で十分だとは思わない—もう一人の占い結果は重要だ。今、実際に誰を疑っているの？（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 10,
      "text": "我直说。我就追问一个点。@あの人  主張に矛盾を感じます。詳細を説明して欲しい。発言の整合性を重視したい。判断材料はもう少し集めたい。感（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 11,
      "text": "我的理由可以说清楚。我就说一句。我先不站死边，但1号的视角开得太早，像在带节奏给狼队找抗推位。"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 12,
      "text": "我直说。我先把自己的思路说清楚。今日はあの人に投票しよう。彼の一貫性のない行動や投票は私たちをミスリードすることを狙っており、これは怪しい。彼の標的の変更はこの怪しさを強め（关注1号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 2,
      "text": "今分かっている確定情報は、私の占い結果だけです。（关注3号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 3,
      "text": "我的理由可以说清楚。大家先把注意力放到这一点上。@あの人  白出し後に票先を変えるのは狼の動き。もう一人襲撃筋もあの人が濃い。（关注5号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 4,
      "text": "我的理由可以说清楚。我就追问一个点。騙り役は誰か。襲撃先案と明日の投票方針を。（关注8号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 5,
      "text": "我的理由可以说清楚。大家先把注意力放到这一点上。あの人の占いが二人の結果で矛盾してるね。@レオンレオンの結果をもう少し詳しくる出して欲しいわ。今後の判断材料にしたいの。みんなも同じ意見だと思うわよ（关注3号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 6,
      "text": "我的理由可以说清楚。大家先把注意力放到这一点上。@あの人  あなたの投票があなたの占い結果と一致していない。説明がない限り、あなたを狼の筆頭候補とみなす。（关注3号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 7,
      "text": "我还在琢磨。我就追问一个点。今日は全員であの人に投票してコンセンサスに合わせ、目立たないようにしておこう—何かが変わらない限り今夜はもう一人を噛む（关注5号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 8,
      "text": "我还在琢磨。我就说一句。どっちの霊媒師が本物なんだ？冒険はトラブル続きだ！（关注3号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 9,
      "text": "我的理由可以说清楚。我先把自己的思路说清楚。@あの人  僕への攻撃は構わないが、@もう一人 の問いに答えたまえ。理由なき黒判定では村は動けない。それが義務だよ。（关注8号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 10,
      "text": "我直说。我就追问一个点。あの人の占い師COに対抗が出ないなら、誰かがより強い証拠を持っていない限り、今日はもう一人を投票で追放すべきだ。（关注3号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 11,
      "text": "我的理由可以说清楚。我就说一句。占い師の判定、必ずしも正しいとは限らないよね（关注5号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 12,
      "text": "我直说。我先把自己的思路说清楚。結果遅れに続く霊媒占い白…真なら痛すぎる。あの人投票じゃ。（关注3号）"
    },
    {
      "round": 3,
      "phase": "DAY_DISCUSSION",
      "speakerId": 10,
      "text": "あの人の説明のない投票と回答拒否は、彼女を私にとって最有力の狼候補にする。今日はあの人に投票する。（关注12号）"
    },
    {
      "round": 3,
      "phase": "DAY_DISCUSSION",
      "speakerId": 11,
      "text": "我的理由可以说清楚。我就说一句。今夜はミナ噛みで賛成。霊媒師CO促して混乱狙おう。表ではグレー吊り推しが妥当かな。（关注5号）"
    },
    {
      "round": 3,
      "phase": "DAY_DISCUSSION",
      "speakerId": 12,
      "text": "我直说。我先把自己的思路说清楚。あの人がもう一人を疑う根拠は何でしょうか。具体的に不自然な点を教えていただけますか。（关注3号）"
    },
    {
      "round": 3,
      "phase": "DAY_DISCUSSION",
      "speakerId": 3,
      "text": "我的理由可以说清楚。大家先把注意力放到这一点上。あの人とカイ不在で材料減。でもサキとケン要注目！（关注5号）"
    },
    {
      "round": 3,
      "phase": "DAY_DISCUSSION",
      "speakerId": 4,
      "text": "我的理由可以说清楚。我就追问一个点。少し整理させて。 @あの人 が私一択まで飛ぶのは結論が早い印象。@もう一人も同じ強さで断定できているの？（关注8号）"
    },
    {
      "round": 3,
      "phase": "DAY_DISCUSSION",
      "speakerId": 5,
      "text": "我的理由可以说清楚。大家先把注意力放到这一点上。あの人の狼籍なる宣告は、我が心の奥底に渦巻く闇を揺さぶる。彼は狼ならば、もう一人は狂人となるであろう。だが、もう一人はあの人を断固として狼と断じ、その言葉には深淵を見据えるような深みを感じてしまう。真相は混沌の淵に沈み、我が進むべき道は霧の中に消えゆく。あの人に投票すべきか、それとももう一人に投票すべきか、我が心は揺り（关注3号）"
    },
    {
      "round": 3,
      "phase": "DAY_DISCUSSION",
      "speakerId": 6,
      "text": "我的理由可以说清楚。大家先把注意力放到这一点上。@あの人、まだ発言少なめだね。今の状況どう思う？（关注8号）"
    },
    {
      "round": 3,
      "phase": "DAY_DISCUSSION",
      "speakerId": 7,
      "text": "我还在琢磨。我就追问一个点。やったー！あの人投票もう一人も賛成！襲撃アベル狙う？@もう一人None（关注5号）"
    },
    {
      "round": 3,
      "phase": "DAY_DISCUSSION",
      "speakerId": 8,
      "text": "我还在琢磨。我就说一句。狼は一人減ったからあの人に濡れ衣を着せてる。彼はずっと一貫してる。私は彼を擁護してる。（关注3号）"
    },
    {
      "round": 3,
      "phase": "DAY_DISCUSSION",
      "speakerId": 9,
      "text": "我的理由可以说清楚。我先把自己的思路说清楚。あの人の黒出し、理由が薄くて納得できないんだけど？何を根拠に選んだのか具体的に聞きたい（关注8号）"
    },
    {
      "round": 4,
      "phase": "DAY_DISCUSSION",
      "speakerId": 5,
      "text": "カナタさんは昨日と今日で考え方に変化ありましたか？（关注3号）"
    },
    {
      "round": 4,
      "phase": "DAY_DISCUSSION",
      "speakerId": 6,
      "text": "我的理由可以说清楚。大家先把注意力放到这一点上。あの人が狂人だったのですね。もう一人の挙動はやはり不自然です。（关注8号）"
    },
    {
      "round": 4,
      "phase": "DAY_DISCUSSION",
      "speakerId": 7,
      "text": "我还在琢磨。我就追问一个点。あの人霊媒師CO。村全体の存続のため、真偽と役割優先順位を判断せよ。（关注6号）"
    },
    {
      "round": 4,
      "phase": "DAY_DISCUSSION",
      "speakerId": 8,
      "text": "我还在琢磨。我就说一句。@アレク、連続で同じ人を占う理由ちゃんと説明してほしい（关注3号）"
    },
    {
      "round": 4,
      "phase": "DAY_DISCUSSION",
      "speakerId": 9,
      "text": "我的理由可以说清楚。我先把自己的思路说清楚。@あの人  破綻した狂人より、失言した狼を先に裁くべきだ。もう一人以外にあり得ない。（关注8号）"
    },
    {
      "round": 4,
      "phase": "DAY_DISCUSSION",
      "speakerId": 11,
      "text": "我的理由可以说清楚。我就说一句。我先不站死边，但6号的视角开得太早，像在带节奏给狼队找抗推位。"
    },
    {
      "round": 4,
      "phase": "DAY_DISCUSSION",
      "speakerId": 3,
      "text": "我的理由可以说清楚。大家先把注意力放到这一点上。今日はリサを占うべきだと思うわ。彼女の発言が薄く、疑念が高まってるから、白黒つけるのが重要だよ。村を（关注6号）"
    },
    {
      "round": 4,
      "phase": "DAY_DISCUSSION",
      "speakerId": 4,
      "text": "我的理由可以说清楚。我就追问一个点。タカシ噛みでOK？発言力高いし早めに潰したい。昼はあの人吊り狙おう。票は一本化推奨。（关注8号）"
