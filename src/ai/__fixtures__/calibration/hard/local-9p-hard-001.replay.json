  "wolfChat": [
    {
      "round": 1,
      "speakerId": 5,
      "message": "あの人の沈黙が続いているのは不利だ。今日は我々の票を彼に集約するのが論理的だ。"
    },
    {
      "round": 1,
      "speakerId": 6,
      "message": "みんな慎重なのは大事だが、早めに推理したほうがいいかもだ。@あの人占い師に関しては、宣言が無ければ無理に名乗る必要はないと思うんだ。どう思う？"
    },
    {
      "round": 1,
      "speakerId": 7,
      "message": "沈黙する者たちに目を向けよ。真実はそこにある。"
    },
    {
      "round": 2,
      "speakerId": 5,
      "message": "灰はあの人寄り!霊吊りが先決。理由を一人に絞れ、もう一人も疑うね。判断材料はもう少し集めたい"
    },
    {
      "round": 2,
      "speakerId": 6,
      "message": "@タクヤ @エリザ 私が占い師を騙る。襲撃はレイ氏で同意を。投票先は明日議論後に。"
    },
    {
      "round": 2,
      "speakerId": 7,
      "message": "@あの人  判定の根拠をもう少し聞かせてください。根拠を整理して臨む。投票履歴も合わせて見る。判断材料はもう少し"
    },
    {
      "round": 3,
      "speakerId": 5,
      "message": "あの人はもう一人の白確定を受けて、急に冷静ですね。"
    },
    {
      "round": 3,
      "speakerId": 6,
      "message": "あの人の私への投票宣言が厳しい。今日は  @もう一人  に投票集めて逃げたい。明日以降の立ち回り相談したい"
    },
    {
      "round": 3,
      "speakerId": 7,
      "message": ">>あの人 そうだね。占い師の名乗り出は大事だと思うよ。誰か来るかな？"
    }
  ],
