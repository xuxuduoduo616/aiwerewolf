  "speeches": [
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 1,
      "text": "[human speech omitted]"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 2,
      "text": "我的理由可以说清楚。我就追问一个点。あの人のもう一人白まで確認。今日はCO順と急な投票宣言を見る！（关注3号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 3,
      "text": "我直说。我先把自己的思路说清楚。@あの人  君の後出し白判定は奇妙だ。初日から結果を出せたはずなのに、なぜ今まで隠した？（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 4,
      "text": "我直说。我先把自己的思路说清楚。霊媒名乗りで票軸はできた。曲げませんだけならあの人処刑です。 @もう一人 票割れ回避の集約先を早めに頼みます。（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 5,
      "text": "我的理由可以说清楚。我就说一句。占い師が一匹か。対抗なし…誰が真か見ものだな！（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 6,
      "text": "我还在琢磨。我就说一句。占い師さん二人も出たね！明日誰が本当か見極めるの楽しみー！（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 7,
      "text": "我的理由可以说清楚。我就追问一个点。やあ、相棒。あの人ともう一人に焦点を当てよう。2人とも占い結果に言及していることだし、証拠を吟味する時間だ！（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 8,
      "text": "我的理由可以说清楚。我就说一句。あの人は理由後出しと占い先のズレで偽目、今日は処刑寄り。（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 9,
      "text": "我直说。我把这个思路捋一下。俺もみんなと同じだ。信頼できる情報を交換しよう。（关注3号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 3,
      "text": "占いCO。昨夜あの人白。今日はもう一人吊りたい。（关注2号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 6,
      "text": ">>あの人 何か意見ある？みんなで意見出し合おう！（关注2号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 4,
      "text": "我直说。我先把自己的思路说清楚。@あの人  庇いは占い後の話。前の根拠がないなら偽。 @もう一人 妥協は村負け。彼を吊るべき。確定。 Over（关注2号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 5,
      "text": "我的理由可以说清楚。我就说一句。犠牲者はなしか。効率的な朝だ。占い師の三名、二日目の結果を即座に開示しろ。（关注2号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 7,
      "text": "我的理由可以说清楚。我就追问一个点。皆、あの人が占った理由に違和感があるっす。トモを黒とする根拠が薄いと思う。（关注2号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 8,
      "text": "我的理由可以说清楚。我就说一句。占い師が名乗り出ないのは危険だよ。投票先考えよう！@シオンシオンの意見に賛成だけど、占い師が気になるね。（关注2号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 9,
      "text": "我直说。我把这个思路捋一下。今日は彼女が黙っていたのであの人に投票する。彼女が村人なら、明日はもう一人の投票行動をより注意深く見る必要がある。（关注4号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 2,
      "text": "我的理由可以说清楚。我就追问一个点。@あの人  もう一人への票は逃げに見える。対抗出しの動機が薄い。やはり狂人疑いだ。（关注4号）"
    },
    {
      "round": 3,
      "phase": "DAY_DISCUSSION",
      "speakerId": 4,
      "text": "あの人が占った狼ちゃん2人がいなくなったしもう一人に移ろう！投票で容疑者リストを絞り込む時間だ！やったね相棒！（关注8号）"
    },
    {
      "round": 3,
      "phase": "DAY_DISCUSSION",
      "speakerId": 5,
      "text": "我的理由可以说清楚。我就说一句。おはよう、 @あの人  その投票保留の根拠を1点で頼む（关注7号）"
    },
    {
      "round": 3,
      "phase": "DAY_DISCUSSION",
      "speakerId": 7,
      "text": "我的理由可以说清楚。我就追问一个点。@ミユ、ダン襲撃が意外って言った理由は？説明を聞きたい（关注5号）"
    },
    {
      "round": 3,
      "phase": "DAY_DISCUSSION",
      "speakerId": 8,
      "text": "我的理由可以说清楚。我就说一句。@あの人  もう一人を守ったのね。もう一人、今の結果に矛盾はないかしら（关注5号）"
    },
    {
      "round": 3,
      "phase": "DAY_DISCUSSION",
      "speakerId": 9,
      "text": "我直说。我把这个思路捋一下。タカシ噛みたい。盤面見る力強いし、後で厄介になりそう。あの人、もう一人はどう思う？（关注7号）"
    }
  ],
