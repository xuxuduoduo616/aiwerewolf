  "wolfChat": [
    {
      "round": 1,
      "speakerId": 1,
      "message": "私が前衛。あなたは後衛。吊りはあの人かもう一人。狂人不在なら私が占い騙り。"
    },
    {
      "round": 1,
      "speakerId": 8,
      "message": "私はMs. あの人を私たちの真に明晰な声とみなすことを提案します。彼女の穏やかな導きは、村人の真実に沿っており、まるでチェスを横切って動く女王のように"
    },
    {
      "round": 1,
      "speakerId": 9,
      "message": "あの人の疑いは精査不足で流せる。今夜はもう一人を噛み、明日はあの人を真扱いして盤面を壊そう。Over"
    },
    {
      "round": 2,
      "speakerId": 1,
      "message": "溶け込むために追放投票はあの人に合わせておいて、霊媒師がCOしない限り今夜は彼を噛む予定でいこう。"
    },
    {
      "round": 2,
      "speakerId": 8,
      "message": "投票はあの人寄せ継続、夜はもう一人噛み優先じゃ"
    },
    {
      "round": 2,
      "speakerId": 9,
      "message": "明日は私あの人白出すね。 @もう一人  ロラ言い出すタイミング任せる"
    }
  ],
