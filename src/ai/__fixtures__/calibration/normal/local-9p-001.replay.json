  "speeches": [
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 1,
      "text": "[human speech omitted]"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 2,
      "text": "我直说。我就追问一个点。あの人は理由後出しと占い先のズレで偽目、今日は処刑寄り。（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 3,
      "text": "我的理由可以说清楚。我先把自己的思路说清楚。ダリルの根拠は曖昧じゃ。言葉選びが雑な占い師は信用できん。（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 4,
      "text": "我的理由可以说清楚。我先把自己的思路说清楚。あの人を黒めに見る。結果軽視でもう一人叩きが不自然。（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 5,
      "text": "我直说。我就追问一个点。団結し続け、脅威としてあの人に焦点を当てよう。村を守ることが鍵だ。（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 6,
      "text": "我还在琢磨。我先把自己的思路说清楚。賢く投票することが極めて重要だ。 私は自分が占い師だと知っている。 あの人は嘘をついている。 私は彼に投票する。  @もう一人  沈黙は危険だ。何か考えや理由は？（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 7,
      "text": "我还在琢磨。我就说一句。霊媒名乗りで票軸はできた。曲げませんだけならあの人処刑です。 @もう一人 票割れ回避の集約先を早めに頼みます。（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 8,
      "text": "我的理由可以说清楚。我就追问一个点。襲撃はアキでどうです？騙り、投票も相談を。（关注2号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 9,
      "text": "我还在琢磨。我就说一句。@あの人  の相方候補として @もう一人 が寡黙すぎて気になる。意見を聞きたい（关注2号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 2,
      "text": "あの人の霊媒師COは信頼に足る動きだね。みんな、もう一人を見守ろう！（关注9号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 4,
      "text": "あの人への集団投票は狼ペアを見落とす危険があると感じる。今日、ペアの中に怪しいラインを見つけられる人いる？（关注1号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 3,
      "text": "我的理由可以说清楚。我先把自己的思路说清楚。占い師が名乗り出ないのは危険だよ。投票先考えよう！@シオンシオンの意見に賛成だけど、占い師が気になるね。（关注5号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 5,
      "text": "我直说。我就追问一个点。あの人を占って、人間だった！あの人が本物の霊媒師だ！勝とう！ダ-ダ-ダ（关注1号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 6,
      "text": "我还在琢磨。我先把自己的思路说清楚。あの人は昨夜の私の占いで人狼と確定しました。今日はあの人に投票し、惑わされないようにしましょう。（关注1号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 7,
      "text": "我还在琢磨。我就说一句。1号铁逻辑断点太明显了，不解释清楚我就先投他。"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 8,
      "text": "我的理由可以说清楚。我就追问一个点。まだ情報が少ない状況だね。慎重に考えないと、話の流れが危うくなるよ。（关注3号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 9,
      "text": "我还在琢磨。我就说一句。次はユリを整理吊りに誘導したい。理由つけやすいし自然な流れで票集められそう。（关注3号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 1,
      "text": "[human speech omitted]"
    }
  ],
