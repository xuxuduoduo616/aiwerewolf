  "wolfChat": [
    {
      "round": 1,
      "speakerId": 1,
      "message": "いい動きです。明日占い師が後出ししてきたら、私が潜伏理由を厳しく問うて怪しむ役をやります。 Over"
    },
    {
      "round": 1,
      "speakerId": 2,
      "message": "んー…今日はあの人偽寄りで見るのは分かる。ただ、もう一人黒まで一気に固めるのは少し早い気がしてる。"
    },
    {
      "round": 1,
      "speakerId": 7,
      "message": "我々の方針は決まった。我々はあの人を攻撃する。明日は村人として装い、味方の先導に従う。  @もう一人  落ち着いた弁明があなたの最良の盾だ。"
    },
    {
      "round": 2,
      "speakerId": 1,
      "message": "投票はあの人寄せ継続、夜はもう一人噛み優先じゃ"
    },
    {
      "round": 2,
      "speakerId": 2,
      "message": "@あの人  判定の根拠をもう少し聞かせてください。投票履歴も合わせて見る。感情論で結論を急がない。矛盾点を洗い出"
    },
    {
      "round": 2,
      "speakerId": 7,
      "message": "決定した。我々の標的はあの人だ。明日は持ち場を維持し、占い師の報告に合わせる。"
    },
    {
      "round": 3,
      "speakerId": 1,
      "message": "@あの人  もう一人への票は逃げに見える。対抗出しの動機が薄い。やはり狂人疑いだ。"
    },
    {
      "round": 3,
      "speakerId": 2,
      "message": "あの人のCOを受け、もう一人が白確定なら他に占い師が出るべきです。この状況は注意が必要です。"
    },
    {
      "round": 3,
      "speakerId": 7,
      "message": "以下は翻訳して欲しい文章です。 翻訳結果のみを出力してください。 ..."
    },
    {
      "round": 4,
      "speakerId": 1,
      "message": "あの人の曖昧な回答を踏まえると、誰かがより有力な手がかりを示せない限り今日はあの人に投票する。みんなはどう思う？"
    },
    {
      "round": 4,
      "speakerId": 2,
      "message": "霊媒師の方が名乗り出ないのは不自然。"
    },
    {
      "round": 4,
      "speakerId": 7,
      "message": "遅れてごめん。あの人は真偽保留が慎重で村目。"
    },
    {
      "round": 5,
      "speakerId": 1,
      "message": "今日はあの人寄り。確霊断定→ロラ投票のズレが重い。"
    },
    {
      "round": 5,
      "speakerId": 2,
      "message": "皆さん、あの人の占いが不自然に感じますね。"
    },
    {
      "round": 5,
      "speakerId": 7,
      "message": "了解ですよぉ。明日は私、あの人は慎重に見るねぇ"
    }
  ],
