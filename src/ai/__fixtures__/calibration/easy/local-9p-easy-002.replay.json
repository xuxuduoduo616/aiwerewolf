  "speeches": [
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 1,
      "text": "[human speech omitted]"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 2,
      "text": "我还在琢磨。我就说一句。あの人への攻撃は議論妨害に見えて怪しいからやめて。今はもう一人の方針を待つ姿勢でいて。Over（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 3,
      "text": "我还在琢磨。我就追问一个点。彼女の支離滅裂な占い師だという主張や投票を受けて、あの人が最も怪しい。今日はあの人に投票する—矛盾が多すぎる。（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 4,
      "text": "我的理由可以说清楚。我把这个思路捋一下。@あの人  私はもう占い師として出ているから、君はそのまま潜伏でお願い。占い先は私が適宜決めるわ。（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 5,
      "text": "我直说。我就说一句。序盤の判断の指針とするため、初夜にあの人を占って人間と確認した。もう一人の圧力と疑念が彼らのmに影を落とした（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 6,
      "text": "我的理由可以说清楚。我把这个思路捋一下。他のプレイヤーの動きを観察中です。特にタクヤの発言には一貫性がなく、怪しいと感じます。今後の意見を参（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 7,
      "text": "我还在琢磨。我先把自己的思路说清楚。@あの人  判定理由が不明なら根拠も必要です。論理を崩すのは霊欠けより先で。感情論で結論を急がない。矛盾点を洗い（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 8,
      "text": "我直说。我把这个思路捋一下。あの人の占い師COは本物だと感じるので今日はもう一人に投票する。もし間違っていたら明日は新しい情報に耳を傾ける。（关注1号）"
    },
    {
      "round": 1,
      "phase": "DAY_DISCUSSION",
      "speakerId": 9,
      "text": "我还在琢磨。我把这个思路捋一下。発言薄い組は気になるね。 @あの人  @もう一人 CO有無と方針、今聞きたい（关注1号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 4,
      "text": "占い師ローラー押そう。今夜はあの人噛みで同意ほしい。ユキは次で。（关注5号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 8,
      "text": "场上先不乱分票，2号要先说清楚自己的立场再说。"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 9,
      "text": "我还在琢磨。我把这个思路捋一下。ミナの進行役、逆に信用しすぎるのは危ない気もする（关注3号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 2,
      "text": "我还在琢磨。我就说一句。占い結果を報告する。俺は占い師だ。昨夜、 @あの人 を占った。結果は『人狼』だ。（关注9号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 3,
      "text": "我还在琢磨。我就追问一个点。今の状況で、特にあの人が怪しい気がするね。彼女の動き、意図が見えないから調査したい。@あの人確かに最近の発言が少ないから、彼女の考えをもっと聞きたいな。何か感じることはないかな？（关注2号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 5,
      "text": "我直说。我就说一句。占いCO済みね。0日目占いはあの人白だったよ。 @もう一人  偽目で見てる。（关注2号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 6,
      "text": "我的理由可以说清楚。我把这个思路捋一下。@あの人  もう一人吊り後も君の怪しい誘導は残る。次は君だ。（关注2号）"
    },
    {
      "round": 2,
      "phase": "DAY_DISCUSSION",
      "speakerId": 7,
      "text": "我还在琢磨。我先把自己的思路说清楚。今あの人に投票する根拠はもう一人の主張だけだ。こんなに序盤で占い師の単COだけを信用するのはリスキーじゃない？（关注3号）"
    },
    {
      "round": 3,
      "phase": "DAY_DISCUSSION",
      "speakerId": 3,
      "text": "あの人とレオンの結果が真逆だから、今日はレオンを占うのが良いと思うっす。彼の占い結果が信頼できるか検証（关注9号）"
    },
    {
      "round": 3,
      "phase": "DAY_DISCUSSION",
      "speakerId": 5,
      "text": "我直说。我就说一句。我こそは未来を透視する者なり。占いの結果、あの人は人狼と判明せり。もう一人、あの人のいずれかが人狼である可能性は高い。もう一人の言葉は深く吟味すべきであろう。あの人に投票せよ。（关注6号）"
    },
    {
      "round": 3,
      "phase": "DAY_DISCUSSION",
      "speakerId": 6,
      "text": "我的理由可以说清楚。我把这个思路捋一下。あの人真の可能性高いと言いつつ反論？変だ。（关注5号）"
    },
    {
      "round": 3,
      "phase": "DAY_DISCUSSION",
      "speakerId": 7,
      "text": "我还在琢磨。我先把自己的思路说清楚。场上5号的表水太虚了，这个位置我要带节奏，一起看发言。"
    },
    {
      "round": 3,
      "phase": "DAY_DISCUSSION",
      "speakerId": 9,
      "text": "我还在琢磨。我把这个思路捋一下。我站好人视角盘，5号的发言有问题，建议今天集中看他的逻辑漏洞。"
    }
  ],
