  "wolfChat": [
    {
      "round": 1,
      "speakerId": 2,
      "message": "@あの人  占い結果だけで決めるのは早計では？他の意見も聞くべきだ。"
    },
    {
      "round": 1,
      "speakerId": 3,
      "message": "偽じゃないです！昨日は発言で警戒、占って白確認です！"
    },
    {
      "round": 1,
      "speakerId": 7,
      "message": "あの人の追及は精査に集中していたと言えば流せます。夜は予定通りもう一人を噛みましょう。あの人が真に見えます"
    },
    {
      "round": 2,
      "speakerId": 3,
      "message": "@あの人  判定の根拠をもう少し聞かせてください。投票履歴も合わせて見る。感情論で結論を急がない。判断材料はもう"
    },
    {
      "round": 2,
      "speakerId": 7,
      "message": "@あの人  もう一人票一番怪しい。理由と占った数を教えてください。今後の流れに注目するね。怪しい動きも見ておくよ。"
    },
    {
      "round": 3,
      "speakerId": 3,
      "message": "@あの人  白出しのタイミングが早すぎる。狂人の動きに見える。追放候補だ。"
    },
    {
      "round": 3,
      "speakerId": 7,
      "message": "あの人噛み進行で異論なければ押します。明日はユキ吊り推し。護衛は霊媒師濃厚、ルカ噛みは一日様子見で。"
    }
  ],
