# ─── AI Werewolf Environment Variables ───────────────────────────────────
# Copy this file to .env.local for local dev, and set these in the
# Netlify dashboard (Site settings → Environment variables) for production.

# ── Gemini API ──
# Get a key at https://aistudio.google.com/apikey
# Used server-side by Netlify Functions. Never prefix this with VITE_.
API_KEY=your_gemini_api_key_here

# ── OpenAI API (optional expression models) ──
# Used only by netlify/functions/provider-adapter.cjs for gpt-5.5 and
# gpt-5.6-luna dialogue. Configure it in Netlify; never expose it to Vite.
OPENAI_API_KEY=

# ── Vercel AI Gateway (optional OpenAI-compatible upstream) ──
# Server-only alternative for the same gpt-5.5 / gpt-5.6-luna product models.
# Configure in Netlify; never create VITE_AI_GATEWAY_API_KEY.
AI_GATEWAY_API_KEY=

# ── Supabase — auth + game records + payment escrow ──
# Project URL from Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# ── Supabase service_role key (server-side only — NEVER in frontend bundle) ──
# Used by payment-escrow Netlify function. Set this in Netlify dashboard.
# Local dev: payment-escrow uses test-mode fallback when this is missing.
SUPABASE_SERVICE_ROLE_KEY=

# ── CORS restriction (production) ──
# Comma-separated list of allowed origins for the AI proxy function.
# Leave empty for local dev (allows all). Set to your domain in production.
ALLOWED_ORIGIN=

# ── Cloudflare Turnstile ──
# Site key (safe to expose in client-side code)
# Get it from https://dash.cloudflare.com/ → Turnstile
# Production site key: 0x4AAAAAAD6sROKmEJ37ulKr
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAD6sROKmEJ37ulKr
