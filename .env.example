# ─── AI Werewolf Environment Variables ───────────────────────────────────
# Copy this file to .env.local for local dev, and set these in the
# Netlify dashboard (Site settings → Environment variables) for production.

# ── Gemini API ──
# Get a key at https://aistudio.google.com/apikey
# Used server-side by Netlify Functions. Never prefix this with VITE_.
API_KEY=your_gemini_api_key_here

# ── DeepSeek dialogue (optional; server-only) ──
# Mark as secret in Netlify. Never use a VITE_ prefix.
# V4.1 Flash API ID is deepseek-flash; Pro is deepseek-v4-pro.
DEEPSEEK_API_KEY=
# ── Volcano Ark / Doubao dialogue (optional; server-only) ──
ARK_API_KEY=
ARK_DOUBAO_MODEL=
# Optional shared per-instance daily admission budget in USD (default 0.05).
# Reserves the maximum output including reasoning before each request.
ADAPTER_DAILY_BUDGET_USD=

# ── Supabase — auth + game records + payment escrow ──
# Project URL from Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# ── Supabase service_role key (server-side only — NEVER in frontend bundle) ──
# Used by payment-escrow Netlify function. Set this in Netlify dashboard.
# Local dev: payment-escrow uses test-mode fallback when this is missing.
SUPABASE_SERVICE_ROLE_KEY=

# ── CORS restriction (production) ──
# Comma-separated list of allowed origins for the AI proxy function.
# Required for Function requests, including local Netlify Dev: exact origin(s).
ALLOWED_ORIGIN=

# ── Cloudflare Turnstile ──
# Site key (safe to expose in client-side code)
# Get it from https://dash.cloudflare.com/ → Turnstile
# Production site key: 0x4AAAAAAD6sROKmEJ37ulKr
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAD6sROKmEJ37ulKr

# Private Bailian speech pilot (Beijing). Leave disabled unless testing.
# Set the first flag at build time. The rest are server-only Functions variables.
VITE_BAILIAN_TTS_ENABLED=
BAILIAN_TTS_ENABLED=
BAILIAN_TTS_TESTER_ID=
# Exact origin, e.g. http://localhost:8888 when using Netlify Dev.
BAILIAN_TTS_PREVIEW_ORIGIN=
DASHSCOPE_API_KEY=
BAILIAN_TTS_API_HOST=
BAILIAN_TTS_PRODUCTION_PILOT=

# ── Qwen ASR (click-to-record voice input) ──
# server-only: read exclusively by netlify/functions/asr-transcribe.cjs.
# Never prefix this with VITE_ and never expose it to the browser bundle.
QWEN_API_KEY=
